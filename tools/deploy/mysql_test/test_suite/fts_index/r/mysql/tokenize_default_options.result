set @doc = _utf8mb4'OceanBase 全文索引、分词器与 Database performance 2.0';
select json_length(tokenize(cast(@doc as char character set utf8mb4), 'ik')) > 0 and cast(tokenize(cast(@doc as char character set utf8mb4), 'ik') as char) =
cast(tokenize(cast(@doc as char character set utf8mb4), 'ik', '[]') as char) as `ik_defaults_match`;
ik_defaults_match
1
select json_length(tokenize(cast(@doc as char character set utf8mb4), 'beng')) > 0 and cast(tokenize(cast(@doc as char character set utf8mb4), 'beng') as char) =
cast(tokenize(cast(@doc as char character set utf8mb4), 'beng', '[]') as char) as `beng_defaults_match`;
beng_defaults_match
1
select json_length(tokenize(cast(@doc as char character set utf8mb4), 'space')) > 0 and cast(tokenize(cast(@doc as char character set utf8mb4), 'space') as char) =
cast(tokenize(cast(@doc as char character set utf8mb4), 'space', '[]') as char) as `space_defaults_match`;
space_defaults_match
1
select json_length(tokenize(cast(@doc as char character set utf8mb4), 'ngram')) > 0 and cast(tokenize(cast(@doc as char character set utf8mb4), 'ngram') as char) =
cast(tokenize(cast(@doc as char character set utf8mb4), 'ngram', '[]') as char) as `ngram_defaults_match`;
ngram_defaults_match
1
select json_length(tokenize(cast(@doc as char character set utf8mb4), 'ngram2')) > 0 and cast(tokenize(cast(@doc as char character set utf8mb4), 'ngram2') as char) =
cast(tokenize(cast(@doc as char character set utf8mb4), 'ngram2', '[]') as char) as `ngram2_defaults_match`;
ngram2_defaults_match
1
select tokenize(_utf8mb4'全文索引与分词器', 'ik',
'[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') as explicit_mode;
explicit_mode
{"tokens": [{"器": 1}, {"索引": 1}, {"分词器": 1}, {"与": 1}, {"全文": 1}, {"分词": 1}, {"全文索引": 1}], "doc_len": 7}
select tokenize('pear apple banana', 'beng',
'[{"additional_args":[{"min_token_size":6}]}]') as explicit_minimum;
explicit_minimum
["banana"]
